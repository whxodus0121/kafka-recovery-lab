# Local host process -> Docker published ports. Never commit .env.
KAFKA_BROKERS=127.0.0.1:9092
KAFKA_PORT=9092
KAFKA_ADVERTISED_HOST=127.0.0.1
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=kafka_recovery_lab
MYSQL_USER=lab
# scripts/env.ps1 -Init generates independent random local passwords.
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
SMOKE_TIMEOUT=60s
# Optional Phase 1 overrides. Existing Phase 0 .env files remain valid.
API_ADDR=127.0.0.1:8080
KAFKA_CONSUMER_GROUP=inventory-main-v1
